{
	"manifest_version": 2,
	"name": "Copy My Email",
	"description": "Copy my email address to clipboard",
	"version": "0.1",
	"author": "Alexander Maltsev",
	"homepage_url": "https://github.com/keltar/tb_copy_my_email",
	"browser_specific_settings": {
		"gecko": {
			"id": "keltar.gw@gmail.com",
			"strict_min_version": "157.0"
		}
	},
	"background": {
		"scripts": [
			"background.js"
		],
		"type": "module"
	},
	"icons": {
		"64": "copy_my_email_icon.svg"
	},
	"permissions": [
		"clipboardWrite",
		"menus",
		"menus.overrideContext",
		"tabs",
		"accountsRead",
		"accountsFolders"
	]
}
